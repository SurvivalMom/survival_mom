# Copy this file to .env and fill in real values. Never commit the real .env
# (it's excluded in .gitignore).
#
# PIPELINE_MODE controls which code path runs. Only "mock" is implemented
# today -- it never reads the keys below. "live" is a reserved value for a
# future implementation that would call paid external APIs; the scripts in
# this pipeline currently raise a clear error if PIPELINE_MODE=live is set,
# rather than silently doing nothing or guessing at an integration.
PIPELINE_MODE=mock

# --- Reserved for the future "live" mode (not implemented yet) ---
# Video generation API key (e.g. a text-to-video provider).
VIDEO_GEN_API_KEY=

# Text-to-speech API key, for narration synthesis.
TTS_API_KEY=

# Optional: override the font used by generate_mock_shots.py's drawtext
# placeholders if DejaVu Sans Bold isn't available on your system.
# FFMPEG_DRAWTEXT_FONT=/path/to/font.ttf
